#include <windows.h>
#include <commctrl.h>
#include "resource.h"
IDD_PREFERENCES DIALOGEX 0, 0, 340, 280
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 CONTROL "", IDC_PREFS_TABS, "SysTabControl32", WS_TABSTOP, 4, 4, 332, 272
END

IDD_TEXT DIALOGEX 0, 0, 250, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Playlist name"
FONT 9, "Segoe UI"
BEGIN
 EDITTEXT IDC_VALUE, 8, 8, 234, 14, ES_AUTOHSCROLL
 DEFPUSHBUTTON "OK", IDOK, 136, 38, 50, 16
 PUSHBUTTON "Cancel", IDCANCEL, 192, 38, 50, 16
END
IDD_PANEL_SETTINGS DIALOGEX 0, 0, 350, 336
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Panel Settings"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "", IDC_PANEL_TABS, "SysTabControl32", WS_TABSTOP, 6, 6, 338, 302
 PUSHBUTTON "&Reset", IDC_PANEL_RESET, 6, 314, 50, 16
 PUSHBUTTON "&Import...", IDC_PANEL_IMPORT, 60, 314, 50, 16
 PUSHBUTTON "E&xport...", IDC_PANEL_EXPORT, 114, 314, 50, 16
 DEFPUSHBUTTON "OK", IDOK, 176, 314, 50, 16
 PUSHBUTTON "Cancel", IDCANCEL, 232, 314, 50, 16
 PUSHBUTTON "&Apply", IDC_PANEL_APPLY, 288, 314, 50, 16
END
IDD_PLAYLIST_CORE DIALOGEX 0, 0, 330, 278
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Double-click", -1, 10, 12, 125, 12
 COMBOBOX IDC_DOUBLE_CLICK, 145, 9, 173, 50, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "Selection opacity (0-255)", -1, 10, 36, 130, 12
 EDITTEXT IDC_SELECTION_ALPHA, 145, 33, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "Focus outline opacity (0-255)", -1, 10, 58, 130, 12
 EDITTEXT IDC_FOCUS_ALPHA, 145, 55, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
 AUTOCHECKBOX "Alternate row colors", IDC_ALTERNATING, 10, 80, 180, 12
 AUTOCHECKBOX "Show Row Extra-Line Infos", IDC_EXTRA_LINE, 10, 101, 210, 12
 AUTOCHECKBOX "Enable hover tooltips", IDC_TOOLTIPS, 10, 122, 200, 12
 LTEXT "Dwell (ms)", -1, 222, 122, 46, 12
 EDITTEXT IDC_TOOLTIP_DELAY, 273, 119, 45, 14, ES_NUMBER | ES_AUTOHSCROLL
 AUTOCHECKBOX "Show selected-track hover tooltips", IDC_SELECTED_TOOLTIPS, 10, 143, 300, 12
 LTEXT "Tooltip title format (Enter inserts a new line)", -1, 10, 164, 308, 12
 EDITTEXT IDC_TOOLTIP_PATTERN, 10, 180, 308, 43, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
 LTEXT "Rating style", -1, 10, 235, 125, 12
 COMBOBOX IDC_RATING_STYLE, 145, 232, 173, 50, CBS_DROPDOWNLIST | WS_TABSTOP
 AUTOCHECKBOX "Minimum row height", IDC_MIN_ROW_HEIGHT_ENABLED, 10, 259, 130, 12
 EDITTEXT IDC_MIN_ROW_HEIGHT, 145, 256, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "px (1-300, text always fits)", -1, 203, 259, 115, 12
END

IDD_AUTOPLAYLIST DIALOGEX 0,0,360,165
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New autoplaylist"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Name", -1, 8, 12, 60, 12
 EDITTEXT IDC_AUTO_NAME, 72, 9, 278, 14, ES_AUTOHSCROLL
 LTEXT "Query", -1, 8, 39, 60, 12
 EDITTEXT IDC_AUTO_QUERY, 72, 36, 278, 40, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
 LTEXT "Sort format", -1, 8, 90, 60, 12
 EDITTEXT IDC_AUTO_SORT, 72, 87, 278, 14, ES_AUTOHSCROLL
 AUTOCHECKBOX "Keep sorted (prevents manual track reordering)", IDC_AUTO_FORCE, 72, 112, 278, 12
 DEFPUSHBUTTON "OK", IDOK, 238, 140, 50, 16
 PUSHBUTTON "Cancel", IDCANCEL, 300, 140, 50, 16
END

IDD_ARTWORK DIALOGEX 0, 0, 330, 230
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 AUTOCHECKBOX "Keep cover aspect ratio", IDC_ART_ASPECT, 10, 10, 150, 12
 LTEXT "Use the Cover and Artist Art columns to choose thumbnail sources.", -1, 10, 29, 308, 12
 LTEXT "Cover margin (0-24)", -1, 10, 50, 130, 12
 EDITTEXT IDC_ART_MARGIN, 144, 48, 42, 14, ES_NUMBER | WS_TABSTOP
 LTEXT "Background source", -1, 10, 71, 105, 12
 COMBOBOX IDC_ART_SOURCE, 118, 68, 202, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Image path / title format (filename supports * and ?)", -1, 10, 92, 310, 12
 EDITTEXT IDC_ART_PATH, 10, 107, 310, 14, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Opacity (0-255)", -1, 10, 131, 90, 12
 EDITTEXT IDC_ART_OPACITY, 102, 128, 42, 14, ES_NUMBER | WS_TABSTOP
 LTEXT "Box blur (0-32)", -1, 174, 131, 95, 12
 EDITTEXT IDC_ART_BLUR, 276, 128, 44, 14, ES_NUMBER | WS_TABSTOP
 LTEXT "Image mode", -1, 10, 154, 90, 12
 COMBOBOX IDC_ART_MODE, 102, 151, 90, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Region", -1, 204, 154, 42, 12
 COMBOBOX IDC_ART_REGION, 246, 151, 74, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Image dimming (0-255)", -1, 10, 178, 126, 12
 EDITTEXT IDC_ART_DIMMING, 144, 175, 42, 14, ES_NUMBER | WS_TABSTOP
 LTEXT "0: no dimming; 255: panel background color. Default: 192.", -1, 10, 198, 310, 12
 LTEXT "Covers fit headers, artwork columns, or rows. F5 reloads artwork.", -1, 10, 215, 310, 12

END

IDD_PANEL_COLUMNS DIALOGEX 0, 0, 330, 392
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Columns shared by every playlist in this panel, in name order", -1, 10, 8, 298, 12
 LISTBOX IDC_SETTINGS_LIST, 10, 22, 214, 92, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
 PUSHBUTTON "New column", IDC_SETTINGS_ADD, 232, 22, 76, 16
 PUSHBUTTON "Delete column", IDC_SETTINGS_DELETE, 232, 42, 76, 16
 PUSHBUTTON "Reset columns", IDC_SETTINGS_RESET, 232, 62, 76, 16
 GROUPBOX "Selected column", -1, 10, 120, 298, 264
 AUTOCHECKBOX "Show this column", IDC_COLUMN_VISIBLE, 18, 134, 200, 12
 LTEXT "Title", -1, 18, 154, 72, 12
 EDITTEXT IDC_TITLE, 94, 152, 206, 14, ES_AUTOHSCROLL
 LTEXT "Title format", -1, 18, 174, 72, 12
 EDITTEXT IDC_PATTERN, 94, 172, 206, 14, ES_AUTOHSCROLL
 LTEXT "Extra-line TF", -1, 18, 194, 72, 12
 EDITTEXT IDC_SECONDARY, 94, 192, 206, 14, ES_AUTOHSCROLL
 LTEXT "Sort format", -1, 18, 214, 72, 12
 EDITTEXT IDC_SORT_PATTERN, 94, 212, 206, 14, ES_AUTOHSCROLL
 LTEXT "Semantic ref", -1, 18, 234, 72, 12
 EDITTEXT IDC_REF, 94, 232, 206, 14, ES_AUTOHSCROLL
 LTEXT "Alignment", -1, 18, 254, 72, 12
 COMBOBOX IDC_ALIGN, 94, 252, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Width weight (%)", -1, 18, 274, 74, 12
 EDITTEXT IDC_PERCENT, 94, 272, 50, 14, ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "Preview (focused track)", -1, 18, 294, 150, 12
 EDITTEXT IDC_TF_PREVIEW, 18, 308, 282, 44, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
 PUSHBUTTON "Title formatting help", IDC_TF_HELP, 18, 360, 112, 16
 LTEXT "Drag column headers to reorder them.", -1, 138, 364, 162, 12
END

IDD_PANEL_GROUPS DIALOGEX 0, 0, 330, 462
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Group templates: built-in templates first, then added ones by name", -1, 10, 8, 298, 12
 LISTBOX IDC_SETTINGS_LIST, 10, 22, 214, 76, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
 PUSHBUTTON "New pattern", IDC_SETTINGS_ADD, 232, 22, 76, 16
 PUSHBUTTON "Delete pattern", IDC_SETTINGS_DELETE, 232, 42, 76, 16
 GROUPBOX "Selected template", -1, 10, 104, 298, 206
 LTEXT "Label", -1, 18, 120, 78, 12
 EDITTEXT 1300, 100, 118, 200, 14, ES_AUTOHSCROLL
 LTEXT "Group key (TF)", -1, 18, 140, 78, 12
 EDITTEXT 1301, 100, 138, 200, 14, ES_AUTOHSCROLL
 LTEXT "Top left (TF)", -1, 18, 160, 78, 12
 EDITTEXT 1302, 100, 158, 200, 14, ES_AUTOHSCROLL
 LTEXT "Top right (TF)", -1, 18, 180, 78, 12
 EDITTEXT 1303, 100, 178, 200, 14, ES_AUTOHSCROLL
 LTEXT "Bottom left (TF)", -1, 18, 200, 78, 12
 EDITTEXT 1304, 100, 198, 200, 14, ES_AUTOHSCROLL
 LTEXT "Bottom right (TF)", -1, 18, 220, 78, 12
 EDITTEXT 1305, 100, 218, 200, 14, ES_AUTOHSCROLL
 LTEXT "Sort order (TF)", -1, 18, 240, 78, 12
 EDITTEXT 1306, 100, 238, 200, 14, ES_AUTOHSCROLL
 LTEXT "Playlist filter", -1, 18, 260, 78, 12
 EDITTEXT 1307, 100, 258, 200, 14, ES_AUTOHSCROLL
 LTEXT "Semicolon-separated playlist names; * is the fallback.", -1, 100, 275, 200, 12
 CONTROL "Show group headers (uncheck for no grouping)", IDC_GROUP_HEADERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 292, 280, 12
 GROUPBOX "Header appearance (shared by all templates)", -1, 10, 318, 298, 136
 LTEXT "Group header height (rows)", -1, 18, 336, 160, 12
 COMBOBOX IDC_GROUP_HEADER_ROWS, 186, 333, 52, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Top left font size", -1, 18, 358, 160, 12
 COMBOBOX IDC_GROUP_TOP_LEFT_SIZE, 186, 355, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Bold", IDC_GROUP_TOP_LEFT_BOLD, 248, 357, 50, 12
 LTEXT "Top right font size", -1, 18, 380, 160, 12
 COMBOBOX IDC_GROUP_TOP_RIGHT_SIZE, 186, 377, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Bold", IDC_GROUP_TOP_RIGHT_BOLD, 248, 379, 50, 12
 LTEXT "Bottom left font size", -1, 18, 402, 160, 12
 COMBOBOX IDC_GROUP_BOTTOM_LEFT_SIZE, 186, 399, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Bold", IDC_GROUP_BOTTOM_LEFT_BOLD, 248, 401, 50, 12
 LTEXT "Bottom right font size", -1, 18, 424, 160, 12
 COMBOBOX IDC_GROUP_BOTTOM_RIGHT_SIZE, 186, 421, 52, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Bold", IDC_GROUP_BOTTOM_RIGHT_BOLD, 248, 423, 50, 12
 LTEXT "Font sizes are point offsets from the main playlist font.", -1, 18, 440, 282, 10
END

IDD_PANEL_MANAGER DIALOGEX 0, 0, 330, 278
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 AUTOCHECKBOX "Hide close buttons on playlist tabs", IDC_HIDE_TAB_CLOSE, 10, 12, 308, 12
 LTEXT "Close buttons sit in a compact frame beside each name. Without them, tabs show only their names; the playing playlist keeps its speaker icon.", -1, 10, 36, 308, 34
 LTEXT "Playlists can still be removed through the tab context menu.", -1, 10, 81, 308, 24
 AUTOCHECKBOX "Highlight active tab text", IDC_TAB_HIGHLIGHT_TEXT, 10, 112, 308, 12
 AUTOCHECKBOX "Show active tab underline", IDC_TAB_UNDERLINE, 10, 134, 308, 12
 AUTOCHECKBOX "Show separators between inactive tabs", IDC_TAB_SEPARATORS, 10, 156, 308, 12
 AUTOCHECKBOX "Use custom highlight color", IDC_TAB_CUSTOM_HIGHLIGHT, 10, 178, 204, 12
 PUSHBUTTON "Choose color...", IDC_TAB_HIGHLIGHT_COLOR, 220, 175, 98, 16
 LTEXT "The highlight color applies to active text and underlines. Uncheck custom color to follow the host highlight color. Drop targets always show an underline.", -1, 10, 205, 308, 36
END
