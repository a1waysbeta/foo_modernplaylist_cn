IDD_PANEL_MANAGER DIALOGEX 0, 0, 330, 278
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Microsoft YaHei UI"
BEGIN
 AUTOCHECKBOX "播放列表管理器置于播放列表下方", IDC_MANAGER_BOTTOM, 10, 12, 308, 12
 AUTOCHECKBOX "隐藏播放列表标签上的关闭按钮", IDC_HIDE_TAB_CLOSE, 10, 34, 308, 12
 LTEXT "关闭按钮默认隐藏。使用标签右键菜单移除播放列表；正在播放的播放列表保留其扬声器图标。", -1, 10, 52, 308, 28
 AUTOCHECKBOX "在标签名称中显示彩色表情符号", IDC_TAB_COLOR_EMOJI, 10, 88, 308, 12
 LTEXT "取消勾选则以标签文字颜色绘制表情符号。", -1, 10, 106, 308, 12
