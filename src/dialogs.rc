 PUSHBUTTON "选择颜色...", IDC_TAB_HIGHLIGHT_COLOR, 220, 191, 98, 16
 LTEXT "高亮颜色应用于活动文字和下划线。取消勾选自定义颜色将跟随宿主高亮颜色。拖放目标始终显示下划线。", -1, 10, 220, 308, 36
END

IDD_PANEL_SEARCH DIALOGEX 0, 0, 330, 278
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Microsoft YaHei UI"
BEGIN
 LTEXT "键入搜索字段", -1, 10, 12, 118, 12
