IDD_TEXT DIALOGEX 0, 0, 250, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "播放列表名称"
FONT 9, "Microsoft YaHei UI"
BEGIN
 EDITTEXT IDC_VALUE, 8, 8, 234, 14, ES_AUTOHSCROLL
 DEFPUSHBUTTON "确定", IDOK, 136, 38, 50, 16
 PUSHBUTTON "取消", IDCANCEL, 192, 38, 50, 16
END
IDD_PANEL_SETTINGS DIALOGEX 0, 0, 350, 336
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "面板设置"
FONT 9, "Microsoft YaHei UI"
